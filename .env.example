PORT=3000
# Paste your MongoDB Atlas connection string below:
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/jira-clone?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/jira-clone?retryWrites=true&w=majority

# JWT signing secret
JWT_SECRET=jira-clone-jwt-super-secret-key-2026

